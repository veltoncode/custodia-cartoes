# --- Supabase ---
# Encontre em: Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# --- NextAuth ---
# Gere um valor aleatório com: openssl rand -base64 32
NEXTAUTH_SECRET=cole-um-valor-aleatorio-aqui
# Em produção, coloque a URL final do site (ex: https://custodia-cartoes.vercel.app)
NEXTAUTH_URL=http://localhost:3000
